"""CryptoRates — курсы криптовалют из открытого API CoinGecko.
Криптовалюта и базовая валюта выбираются выпадающими списками.
"""
import tkinter as tk
from tkinter import *
from tkinter import messagebox as mb
from tkinter import ttk
import requests

API_URL = "https://api.coingecko.com/api/v3/simple/price"

# Список криптовалют
# Можно получить список через API https://api.coingecko.com/api/v3/coins/list
# Выбраны наиболее известные
crypto = {
    "bitcoin":   ("Bitcoin",   "BTC"),
    "ethereum":  ("Ethereum",  "ETH"),
    "tether":    ("Tether",    "USDT"),
    "solana":    ("Solana",    "SOL"),
    "dogecoin":  ("Dogecoin",  "DOGE"),
}

# Список валют
# Можно получить список через API https://api.coingecko.com/api/v3/simple/supported_vs_currencies
# Выбраны наиболее известные
currencies = {
    "usd": ("Доллар США (USD)", "$"),
    "eur": ("Евро (EUR)", "€"),
    "rub": ("Рубль (RUB)", "₽"),
    "gbp": ("Фунт (GBP)", "£"),
    "jpy": ("Иена (JPY)", "¥"),
}


def add_combobox(main_window, title, values, event_func):
    # Функция вывода блока интерфейсных элементов: список валют, его наименование и текущее значение
    # Наименование списка
    label = Label(main_window, text=title, font='Arial, 15', justify=CENTER)
    label.config(bg='light blue', fg='dark blue')
    label.pack(pady=5)
    # Список значений
    combobox = ttk.Combobox(main_window, values=list(values.keys()), state='readonly')
    combobox.pack(pady=3, padx=10)
    # Текстовое описание значения
    combo_label = tk.Label(main_window, text="", bg='light blue')
    combo_label.pack()
    # Обновление описания при смене значения
    combobox.bind('<<ComboboxSelected>>', event_func)
    return combobox, combo_label


def update_crypto_label(event):
    """Смена названия криптовалюты при выборе в списке."""
    code = crypto_combobox.get()
    crypto_label.config(text=crypto[code][0])


def update_currency_label(event):
    """Смена названия базовой валюты при выборе в списке."""
    code = currency_combobox.get()
    currency_label.config(text=currencies[code][0])


def exchange():
    # Функция получения и вывода курса криптовалюты
    crypto_code = crypto_combobox.get().strip()     # криптовалюта, напр. bitcoin
    currency_code = currency_combobox.get().strip() # валюта, напр. usd
    # Проверяем, что обе валюты заданы
    if not crypto_code or not currency_code:
        mb.showwarning('Внимание', 'Выберите обе валюты')
        return

    try:
        response = requests.get(API_URL, params={
            "ids": crypto_code,             # id криптовалюты
            "vs_currencies": currency_code, # базовая валюта
        }, timeout=10)
        response.raise_for_status()
        data = response.json()             # ожидаемый формат {"bitcoin": {"usd": 68250.5}}

        if crypto_code in data and currency_code in data[crypto_code]:
            # Выбранные криптовалюта и валюта есть в ответе
            rate = data[crypto_code][currency_code]
            _, crypto_name = crypto[crypto_code]
            currency_name, currency_symbol = currencies[currency_code]
            mb.showinfo('Курс обмена',
                        f'1 {crypto_name} = {currency_symbol}{rate:,.2f} ({currency_name})')
        else:
            mb.showerror('Ошибка', f'Курс для {crypto_code} не найден')
    except requests.exceptions.HTTPError as e:
        mb.showerror('Ошибка', f'Ошибка сервера: HTTP {e.response.status_code}')
    except requests.exceptions.RequestException:
        mb.showerror('Ошибка', 'Нет соединения с api.coingecko.com')

# Основное окно приложения
image = 'image.ico'
window = Tk()
window.title("Курс криптовалют")
window.geometry("420x320")
window.iconbitmap(image)
window.config(bg='light blue')

# Выводим блок элементов валют
currency_combobox, currency_label = add_combobox(window, 'Базовая валюта', currencies, update_currency_label)
# Выводим блок элементов криптовалют
crypto_combobox, crypto_label = add_combobox(window, 'Криптовалюта', crypto, update_crypto_label)

# Кнопка получения курса
Button(window, text='Получить курс обмена', font='Arial, 12', bg='dark blue', fg='white',
       command=exchange).pack(pady=10, padx=10)

window.mainloop()
